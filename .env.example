# Porta do Host onde a aplicação web responderá
PORT=3740

# Duração do ciclo completo de varredura das 71 páginas (em dias)
# 4 dias = ~1 página a cada 80 minutos (espaçamento anti-bloqueio)
SCRAPE_CYCLE_DAYS=4

# Ativar execução imediata de teste/bootstrap na subida (false em produção)
SCRAPE_BOOTSTRAP_ON_START=false

# Geocodificação OpenStreetMap / Nominatim (Opcional)
# Deixe vazio para usar o identificador padrão do repositório
# GEOCODER_CONTACT_EMAIL=
# GEOCODER_USER_AGENT=MapaCDVsRS/1.0 (+https://github.com/moothz/mapa-cdvs-rs)

# Chave do Google Maps / Geocoding API (Opcional)
# Se informada, o geocodificador busca direto no Google Maps para precisão milimétrica
# GOOGLE_GEOCODING_API_KEY=AIzaSy...

# URL Externa (para referências)
EXTERNAL_URL=http://localhost:3740

# Credenciais do Painel de Moderação (/admin e Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Notificações e Moderação via Telegram (Opcional)
# Obtenha o token com @BotFather e o Chat ID com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
